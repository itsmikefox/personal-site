---
import { SITE_TITLE, NAV } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

// Highlight the active section. We match on the first path segment so that
// /writing/some-post still lights up the "Writing" tab.
const path = Astro.url.pathname;
const section = "/" + (path.split("/")[1] ?? "");
const isActive = (href: string) =>
  href === section || (href !== "/" && path.startsWith(href));
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>{SITE_TITLE}</a>

    <nav class="nav" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={["nav__link", { "is-active": isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(6px);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }
  .brand {
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .brand:hover { color: var(--accent); }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .nav__link {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav__link:hover {
    color: var(--accent);
    background: var(--accent-wash);
  }
  .nav__link.is-active {
    color: var(--accent-strong);
    background: var(--accent-wash);
  }

  /* On narrow screens the nav wraps under the brand row. */
  @media (max-width: 34rem) {
    .site-header__inner {
      flex-wrap: wrap;
    }
    .brand { margin-right: 0; }
    .nav { order: 3; width: 100%; }
  }
</style>
