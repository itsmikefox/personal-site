---
import { SITE_TITLE, NAV } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

// Highlight the active section. We match on the first path segment so that
// /writing/some-post still lights up the "Writing" tab.
const path = Astro.url.pathname;
const section = "/" + (path.split("/")[1] ?? "");
const isActive = (href: string) =>
  href === section || (href !== "/" && path.startsWith(href));
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>{SITE_TITLE}</a>

    <nav class="nav" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            data-section={item.href.replace("/", "")}
            class:list={["nav__link", { "is-active": isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(6px);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }
  .brand {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    color: var(--brand);
    text-decoration: none;
    margin-right: auto;
  }
  .brand:hover { color: var(--accent-strong); }

  /* Links stretch to the full header height so the active tab's fill
     can run from the top of the row down through the header's bottom
     padding and meet the border — a true tab seated on the line. */
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-self: stretch;
    align-items: stretch;
  }
  /* The active section is a square filled tab in its identity color;
     everything else stays quiet — no hover treatment. Color is never
     the only cue: active links also gain weight and carry aria-current.
     Sections without a color fall back to orange. */
  .nav__link {
    display: inline-flex;
    align-items: center;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 0 0.7rem;
  }
  /* Orange is both the projects fill and the fallback for uncolored
     sections; it takes prussian type — orange can't carry white.
     The bottom padding + negative margin extend the fill to the
     header border while the text stays centered on the row. */
  .nav__link.is-active {
    font-weight: 650;
    color: #0b2652;
    background: var(--fill-projects);
    padding-bottom: var(--space-sm);
    margin-bottom: calc(-1 * var(--space-sm));
  }
  .nav__link[data-section="writing"].is-active {
    color: #ffffff;
    background: var(--fill-writing);
  }
  .nav__link[data-section="poetry"].is-active {
    color: #ffffff;
    background: linear-gradient(135deg, var(--fill-poetry-a), var(--fill-poetry-b));
  }
  .nav__link[data-section="music"].is-active {
    color: #ffffff;
    background: var(--fill-music);
  }

  /* On narrow screens the nav wraps under the brand row. */
  @media (max-width: 34rem) {
    .site-header__inner {
      flex-wrap: wrap;
    }
    .brand { margin-right: 0; }
    .nav { order: 3; width: 100%; }
  }
</style>
