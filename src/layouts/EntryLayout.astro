---
import BaseLayout from "./BaseLayout.astro";
import { SITE_TITLE } from "../consts";

// Shared layout for a single piece of writing, a single poem, or a project.
interface Props {
  title: string;
  description?: string;
  date?: Date;
  updatedDate?: Date;
  /** Social share image for this entry (root-relative path or absolute URL). */
  ogImage?: string;
  /** When the piece was composed, if different from `date` (poems: "2019", "2019-03"). */
  written?: string;
  backHref: string;
  backLabel: string;
  tags?: string[];
  /** Poems read best a touch narrower and centered; writing uses full measure. */
  variant?: "writing" | "poetry" | "project";
}

const {
  title,
  description,
  date,
  updatedDate,
  ogImage,
  written,
  backHref,
  backLabel,
  tags = [],
  variant = "writing",
} = Astro.props;

// timeZone: "UTC" — frontmatter dates parse as UTC midnight and would
// otherwise render a day early in western timezones.
const dateStr = date
  ? date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })
  : undefined;

// JSON-LD structured data: BlogPosting for writing, CreativeWork for poems,
// and for a project the more specific CreativeWork subtype — a build is a
// thing that was made, not a thing that was published.
const iso = (d: Date) => d.toISOString().split("T")[0];
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const author = { "@type": "Person", name: SITE_TITLE, url: Astro.site?.href };
const schema =
  variant === "poetry"
    ? {
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        name: title,
        genre: "Poetry",
        inLanguage: "en",
        ...(description && { description }),
        ...(date && { datePublished: iso(date) }),
        ...(written && { dateCreated: written }),
        author,
        mainEntityOfPage: pageUrl,
      }
    : variant === "project"
    ? {
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        name: title,
        ...(description && { description }),
        ...(date && { dateCreated: iso(date) }),
        ...(tags.length > 0 && { keywords: tags.join(", ") }),
        ...(ogImage && { image: new URL(ogImage, Astro.site).href }),
        creator: author,
        mainEntityOfPage: pageUrl,
      }
    : {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        ...(description && { description }),
        ...(date && { datePublished: iso(date) }),
        ...(updatedDate && { dateModified: iso(updatedDate) }),
        ...(tags.length > 0 && { keywords: tags.join(", ") }),
        ...(ogImage && { image: new URL(ogImage, Astro.site).href }),
        author,
        mainEntityOfPage: pageUrl,
      };
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  article={date ? { published: date, updated: updatedDate } : undefined}
  schema={schema}
>
  <article class:list={["entry-page", `entry-page--${variant}`]}>
    <a href={backHref} class="back">← {backLabel}</a>

    <header class="entry-page__head">
      <h1>{title}</h1>
      {
        (dateStr || tags.length > 0) && (
          <div class="entry-page__meta">
            {dateStr && <time>{dateStr}</time>}
            {tags.length > 0 && (
              <span class="tag-row">
                {tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </span>
            )}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover { color: var(--accent); }

  .entry-page__head { margin-bottom: var(--space-lg); }
  .entry-page__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xs);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Poetry reads best with tighter leading and clear stanza spacing.
     Convention: end each line with a backslash for a line break; separate
     stanzas with a blank line (each stanza becomes its own paragraph). */
  .entry-page--poetry :global(.prose) {
    font-size: var(--text-xl);
    line-height: 1.5;
  }
  .entry-page--poetry :global(.prose p) {
    margin-bottom: var(--space-lg);
  }
</style>
