---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

// Preload the latin subsets of every face that's visible on first paint,
// so text doesn't flash in the fallback serif/sans before the webfonts
// arrive (the @fontsource CSS uses font-display: swap).
import frauncesRoman from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import frauncesItalic from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url";
import interRoman from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import newsreaderRoman from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
const preloadFonts = [frauncesRoman, frauncesItalic, interRoman, newsreaderRoman];

interface Props {
  title?: string;
  description?: string;
  /** Use the wider column (listings, grids) instead of the reading measure. */
  wide?: boolean;
  /** Social share image — root-relative path ("/images/foo.png") or absolute URL. */
  ogImage?: string;
  /** Dated content (posts, poems): switches og:type to article and emits publish dates. */
  article?: { published: Date; updated?: Date };
  /** JSON-LD structured data, serialized into <head>. */
  schema?: object | object[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  wide = false,
  ogImage,
  article,
  schema,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    {preloadFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    <!-- summary_large_image only when there's actually an image to show. -->
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}

    <!-- Apply the saved theme BEFORE paint to avoid a flash.
         Night Edition (dark) is the site default; the toggle's saved
         choice wins over it. -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme") || "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <div class:list={["container", { "container--wide": wide }]}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
