---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { personSchema } from "../lib/author";

// Pull the three most recent, non-draft writing entries for the homepage.
const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// The newest poem supplies the "poetry shelf" excerpt: its first three lines.
// Poem bodies use markdown hard breaks (trailing backslashes) — strip them.
const poems = (await getCollection("poetry", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPoem = poems[0];
const excerptLines = (latestPoem?.body ?? "")
  .trim()
  .split("\n")
  .map((l) => l.replace(/\\$/, "").trim())
  .filter(Boolean)
  .slice(0, 3);

const fmt = (d: Date) =>
  // Frontmatter dates parse as UTC midnight — format in UTC so they don't
  // slip back a day in western timezones.
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

// Entity markup for the homepage: this site, and the person it belongs to.
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: Astro.site?.href,
  },
  personSchema(Astro.site?.href),
];
---

<BaseLayout schema={schema}>
  <section class="intro">
    <h1>Software by day.<br />Everything else after dark.</h1>
    <p class="lead">
      I'm Mike Fox, I live in Chicago and I try to find new and unique ways to cross pollinate my interests. That means
      songs (as BigBluestem), circuits, software, writing, art and design, ecology
      and gardening. This is where any results pile up. <a href="/about">More about me →</a>
    </p>
  </section>

  <div class="cols">
    <section class="home-block">
      <h2 class="sec">Recent writing</h2>
      {
        posts.length === 0 ? (
          <p class="muted">No posts yet — your first one is waiting in <code>src/content/writing/</code>.</p>
        ) : (
          <ol class="idx">
            {posts.map((post) => (
              <li>
                <a href={`/writing/${post.id}/`}>{post.data.title}</a>
                <span class="idx__date">{fmt(post.data.pubDate)}</span>
              </li>
            ))}
            <li class="idx__more">
              <a href="/writing">All writing →</a>
            </li>
          </ol>
        )
      }
    </section>

    <section class="home-block">
      <h2 class="sec">From the poetry shelf</h2>
      {
        latestPoem ? (
          <blockquote class="poem">
            <p>{excerptLines.map((line) => (<>{line}<br /></>))}</p>
            <cite>
              from <a href={`/poetry/${latestPoem.id}/`}>“{latestPoem.data.title}”</a>
              · <a href="/poetry">{poems.length} poems →</a>
            </cite>
          </blockquote>
        ) : (
          <p class="muted">No poems yet — add one to <code>src/content/poetry/</code>.</p>
        )
      }
    </section>
  </div>

</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--space-2xl);
  }
  /* The hero is the one place the display face runs at full weight.
     --hero is orange in Night Edition, prussian ink in Morning. */
  .intro h1 {
    font-weight: 900;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--hero);
    margin-bottom: var(--space-md);
    text-wrap: balance;
  }
  .lead {
    font-size: var(--text-xl);
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .cols {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  @media (max-width: 44rem) {
    .cols { grid-template-columns: 1fr; gap: var(--space-lg); }
  }

  .sec {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  /* Numbered writing index */
  .idx {
    counter-reset: n;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .idx li {
    counter-increment: n;
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border);
  }
  .idx li::before {
    content: counter(n, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .idx li:last-child { border-bottom: none; }
  .idx a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--ink);
    text-decoration: none;
  }
  .idx a:hover { color: var(--accent); }
  .idx__date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-left: auto;
    white-space: nowrap;
  }
  .idx li.idx__more::before { content: "→"; }
  .idx__more a {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--accent);
  }

  /* Poetry shelf excerpt */
  .poem {
    margin: 0;
    padding: var(--space-2xs) 0 var(--space-2xs) var(--space-md);
    border-left: 3px solid var(--mark);
  }
  .poem p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--ink);
    margin: 0 0 var(--space-sm);
  }
  .poem cite {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .poem cite a { color: var(--accent); text-decoration: none; }
  .poem cite a:hover { text-decoration: underline; }

  .muted { color: var(--muted); }
</style>
