---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NowSpinning from "../components/NowSpinning.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { personSchema } from "../lib/author";

// Pull the three most recent, non-draft writing entries for the homepage.
const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// The newest poem supplies the "poetry shelf" excerpt: its first three lines.
// Poem bodies use markdown hard breaks (trailing backslashes) — strip them.
const poems = (await getCollection("poetry", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPoem = poems[0];
const excerptLines = (latestPoem?.body ?? "")
  .trim()
  .split("\n")
  .map((l) => l.replace(/\\$/, "").trim())
  .filter(Boolean)
  .slice(0, 3);

const fmt = (d: Date) =>
  // Frontmatter dates parse as UTC midnight — format in UTC so they don't
  // slip back a day in western timezones.
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

// Entity markup for the homepage: this site, and the person it belongs to.
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: Astro.site?.href,
  },
  personSchema(Astro.site?.href),
];
---

<BaseLayout schema={schema}>
  <section class="hero">
    <div class="intro">
      <h1>Hello</h1>
      <p class="lead">
       I'm Mike Fox, I'm an American Midwesterner located in <a href="https://bplant.org/region/743">Ecoregion 54b</a>. I create songs (as Big Bluestem), circuits, software, essays, art, furniture, and (with luck) gardens.
      </p>
      <p class="lead-more"><a href="/about">More about me →</a></p>
    </div>

    <img
      class="hero-photo"
      src="/images/sunflower-720.jpg"
      srcset="/images/sunflower-480.jpg 480w, /images/sunflower-720.jpg 720w, /images/sunflower-1080.jpg 1080w"
      sizes="(max-width: 44rem) 100vw, 18rem"
      width="720"
      height="959"
      alt="Mike standing at dusk in a backyard garden, beneath a sunflower more than twice his height"
      loading="eager"
      decoding="async"
    />
  </section>

  <section class="home-block">
    <h2 class="sec">Recent writing</h2>
    {
      posts.length === 0 ? (
        <p class="muted">No posts yet.</p>
      ) : (
        <ol class="idx">
          {posts.map((post) => (
            <li>
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
              <span class="idx__date">{fmt(post.data.pubDate)}</span>
            </li>
          ))}
          <li class="idx__more">
            <a href="/writing">All writing →</a>
          </li>
        </ol>
      )
    }

    <h3 class="sub">From the poetry shelf</h3>
    {
      latestPoem ? (
        <blockquote class="poem">
          <p>{excerptLines.map((line) => (<span class="line">{line}</span>))}</p>
          <cite>
            from <a href={`/poetry/${latestPoem.id}/`}>“{latestPoem.data.title}”</a>
            · <a href="/poetry">{poems.length} poems →</a>
          </cite>
        </blockquote>
      ) : (
        <p class="muted">No poems yet.</p>
      )
    }
  </section>

  <NowSpinning />

</BaseLayout>

<style>
  /* Hero: the lead sits beside the garden portrait, which aligns its right
     edge to the content column below it. */
  .hero {
    display: grid;
    grid-template-columns: 1fr 18rem;
    gap: var(--space-lg);
    align-items: start;
    margin-bottom: var(--space-2xl);
  }
  .hero-photo {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    display: block;
  }
  @media (max-width: 44rem) {
    .hero { grid-template-columns: 1fr; gap: var(--space-lg); }
    .hero-photo { max-width: 22rem; }
  }
  /* The hero is the one place the display face runs at full weight.
     --hero is orange in Night Edition, prussian ink in Morning. */
  .intro h1 {
    font-weight: 900;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--hero);
    margin-bottom: var(--space-md);
    text-wrap: balance;
  }
  .lead {
    font-size: var(--text-xl);
    color: var(--ink-soft);
    max-width: 34rem;
  }
  /* Its own line, so the arrow never gets orphaned mid-phrase. */
  .lead-more {
    margin-top: var(--space-md);
  }
  .lead-more a {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-base);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .lead-more a:hover {
    text-decoration: underline;
  }

  .home-block {
    margin-bottom: var(--space-xl);
  }

  /* Sub-heading inside "Recent writing" — quieter than .sec so the poetry
     shelf reads as part of the section rather than a rival to it. */
  .sub {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: var(--space-xl) 0 var(--space-md);
  }

  .sec {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  /* Numbered writing index */
  .idx {
    counter-reset: n;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .idx li {
    counter-increment: n;
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border);
  }
  .idx li::before {
    content: counter(n, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .idx li:last-child { border-bottom: none; }
  .idx a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--ink);
    text-decoration: none;
  }
  .idx a:hover { color: var(--accent); }
  .idx__date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-left: auto;
    white-space: nowrap;
  }
  .idx li.idx__more::before { content: "→"; }
  .idx__more a {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--accent);
  }

  /* Poetry shelf excerpt */
  .poem {
    margin: 0;
    padding: var(--space-2xs) 0 var(--space-2xs) var(--space-md);
    border-left: 3px solid var(--mark);
  }
  .poem p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--ink);
    margin: 0 0 var(--space-sm);
  }
  /* Each verse line is its own block, so a line too long for the column
     indents on wrap instead of masquerading as the poet's own break. */
  .poem .line {
    display: block;
    padding-left: 1.25em;
    text-indent: -1.25em;
  }
  .poem cite {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .poem cite a { color: var(--accent); text-decoration: none; }
  .poem cite a:hover { text-decoration: underline; }

  .muted { color: var(--muted); }
</style>
