---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Base from "../../components/base/Base.astro";
import { getCollection } from "astro:content";
import { buildPoetry } from "../../lib/bases";

// Text-forward Base: a Ledger index (default) leading with each poem's real
// opening line, plus a sortable Table. buildPoetry derives the opening line and
// length from the poem body.
const entries = await getCollection("poetry", ({ data }) => !data.draft);
const config = buildPoetry(entries);
---

<BaseLayout title="Poetry" description="Poems.">
  <div class="page-head">
    <h1>Poetry</h1>
    <p>Short verse, kept plain.</p>
  </div>

  <Base {...config} />
</BaseLayout>
