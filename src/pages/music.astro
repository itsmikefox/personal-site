---
import BaseLayout from "../layouts/BaseLayout.astro";

// Simple, editable list of tracks/releases. For real embeds, paste a
// Bandcamp / SoundCloud / Spotify iframe into the `embed` field (raw HTML).
interface Track {
  title: string;
  meta?: string;
  description?: string;
  href?: string;
}

const tracks: Track[] = [
  {
    title: "Untitled Demo",
    meta: "2025 · Home recording",
    description: "Swap these out for your real tracks. Add a link or an embed below.",
    href: "",
  },
];
---

<BaseLayout title="Music" description="Tracks and recordings.">
  <div class="page-head">
    <h1>Music</h1>
    <p>Recordings, demos, and whatever else I've been making.</p>
  </div>

  <ul class="entry-list">
    {
      tracks.map((t) => (
        <li class="entry">
          {t.href ? <a href={t.href}>{t.title}</a> : <span class="entry__title-static">{t.title}</span>}
          {t.meta && <div class="entry__meta">{t.meta}</div>}
          {t.description && <p class="entry__excerpt">{t.description}</p>}
        </li>
      ))
    }
  </ul>

  <p class="hint">
    Tip: to embed a player, drop a Bandcamp/SoundCloud/Spotify iframe straight
    into this page — Astro renders raw HTML as-is.
  </p>
</BaseLayout>

<style>
  .entry__title-static {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--ink);
  }
  .hint {
    margin-top: var(--space-xl);
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
