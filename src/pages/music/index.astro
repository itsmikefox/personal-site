---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Base from "../../components/base/Base.astro";
import { getCollection } from "astro:content";
import { buildMusic } from "../../lib/bases";

// One Base, two lenses: a cover-art Gallery (default) and a sortable Table.
// buildMusic handles the newest-first sort and derives the genre/artist/decade
// facets from frontmatter.
const entries = await getCollection("music", ({ data }) => !data.draft);
const config = buildMusic(entries);
---

<BaseLayout
  title="Music"
  description="Records I've made and played on!"
  wide
>
  <div class="page-head">
    <h1>Music</h1>
    <p>Recordings, demos, and assorted musical errata.</p>
  </div>

  <Base {...config} />
</BaseLayout>
