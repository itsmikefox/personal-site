---
import BaseLayout from "../layouts/BaseLayout.astro";
import Base from "../components/base/Base.astro";
import BookPanel from "../components/BookPanel.astro";
import { getCollection } from "astro:content";
import { buildBooks } from "../lib/bases";
import { SITE_TITLE } from "../consts";

// The shelf out of Obsidian. `pnpm books` regenerates the snapshot
// this reads; nothing here is hand-maintained!!!
const entries = await getCollection("books");
const config = buildBooks(entries);

const withCover = config.items.filter((it) => it.cover).length;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Library · ${SITE_TITLE}`,
  description: `A catalog of the ${config.items.length} books on Mike Fox's shelves, browsable by genre, decade, and format.`,
  url: new URL("/library", Astro.site).href,
  about: { "@type": "Thing", name: "Books" },
  mainEntity: {
    "@type": "Collection",
    name: "Mike Fox's library",
    collectionSize: config.items.length,
  },
};
---

<BaseLayout
  title="Library"
  description={`Every book we've got in the house: ${config.items.length} of them and counting! searchable by genre, decade, and format!`}
  wide
  schema={schema}
>
  <div class="page-head">
    <h1>Library</h1>
    <p>
      Every book in our house: {config.items.length} books/magazines/zines. Click on one if you'd like more info, or if you want to request me to lend it out!
    </p>
  </div>

  <Base {...config} />
  <BookPanel items={config.items} />
</BaseLayout>
