---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIALS } from "../consts";
const links = SOCIALS.filter((s) => s.href);
---

<BaseLayout title="About" description="A little about me and how to get in touch.">
  <div class="page-head">
    <h1>About</h1>
  </div>

  <div class="prose">
    <p>
      Howdy, I'm Mike. I'm a musician, artist, maker, and writer. I live in Ecoregion 34b (Chicago, IL) with my partner Erin.
    </p>
    <p>
      I currently release music under the name BigBluestem. I also work as the technical lead for the indie printbroker PrintNinja.
      I love physics, electronics and good stories. Tryin' to cover all my bases before I die.
    </p>

    <h2>Get in touch</h2>
    <p>The best ways to reach me:</p>
    <ul>
      {links.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
    </ul>
  </div>
</BaseLayout>
