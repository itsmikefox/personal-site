---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Base from "../../components/base/Base.astro";
import { getCollection } from "astro:content";
import { buildProjects } from "../../lib/bases";

// A sortable Table (default) plus a card grid. Filterable by tag and year;
// each entry links out to its href.
const entries = await getCollection("projects", ({ data }) => !data.draft);
const config = buildProjects(entries);
---

<BaseLayout title="Projects" wide>
  <div class="page-head">
    <h1>Projects</h1>
    <p>Things I've designed, built, or helped ship.</p>
  </div>

  <Base {...config} />
</BaseLayout>
