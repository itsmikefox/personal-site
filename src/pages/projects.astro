---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects" wide>
  <div class="page-head">
    <h1>Projects</h1>
    <p>Things I've designed, built, or helped ship.</p>
  </div>

  <div class="grid">
    {
      projects.map((p) => {
        const inner = (
          <>
            <h3>{p.title}{p.href && " →"}</h3>
            <p>{p.description}</p>
            {(p.tags.length > 0 || p.year) && (
              <div class="tag-row">
                {p.year && <span class="tag">{p.year}</span>}
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            )}
          </>
        );
        return p.href ? (
          <a class="card" href={p.href} target="_blank" rel="noopener">
            {inner}
          </a>
        ) : (
          <div class="card card--static">{inner}</div>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .card--static:hover {
    border-color: var(--border);
    transform: none;
    cursor: default;
  }
</style>
