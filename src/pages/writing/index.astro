---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title="Writing" description="Essays, notes, and technical writing.">
  <div class="page-head">
    <h1>Writing</h1>
    <p>Essays, notes, and the occasional technical deep-dive.</p>
  </div>

  {
    posts.length === 0 ? (
      <p class="muted">
        No posts yet. Drop a Markdown file in <code>src/content/writing/</code> to begin.
      </p>
    ) : (
      <ul class="entry-list">
        {posts.map((post) => (
          <li class="entry">
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            <div class="entry__meta">{fmt(post.data.pubDate)}</div>
            {post.data.description && <p class="entry__excerpt">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .muted { color: var(--muted); }
</style>
