---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Base from "../../components/base/Base.astro";
import { getCollection } from "astro:content";
import { buildWriting } from "../../lib/bases";

// Text-forward Base: a Ledger index (default) leading with each post's
// description, plus a sortable Table. Filterable by tag.
const entries = await getCollection("writing", ({ data }) => !data.draft);
const config = buildWriting(entries);
---

<BaseLayout title="Writing" description="Essays, notes, and technical writing.">
  <div class="page-head">
    <h1>Writing</h1>
    <p>Essays, notes, and the occasional technical deep-dive.</p>
  </div>

  <Base {...config} />
</BaseLayout>
